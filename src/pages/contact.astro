---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';

const title = 'Contact Forrester Fields | Book a Consultation';
const description =
  'Contact Forrester Fields to book a free wedding or event planning consultation in Loganville, GA. Tell us your date, venue & budget for a fast, personal reply.';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: site.url + '/contact' },
  ],
};
---

<BaseLayout title={title} description={description} schemas={[breadcrumb]}>
  <section class="page-hero section--alt">
    <div class="container text-center" data-reveal>
      <p class="eyebrow eyebrow--center">Let&rsquo;s Get Started!</p>
      <h1>Book your free consultation</h1>
      <p class="lede">Email me or fill out the form below regarding your wedding planning or special event and I&rsquo;ll get back to you as soon as possible. Together, we can bring your vision to life!</p>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container contact-grid">
      <aside class="contact-aside" data-reveal>
        <h2>Reach out</h2>
        <ul class="contact-list">
          <li>
            <span class="label">Email</span>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <span class="label">Based in</span>
            <span>Loganville, Georgia</span>
          </li>
          <li>
            <span class="label">Serving</span>
            <span>Walton County, Monroe, Snellville, Grayson, Conyers, Covington &amp; east-metro Atlanta</span>
          </li>
          <li>
            <span class="label">Follow along</span>
            <span class="social-links">
              <a href={site.social.instagram} target="_blank" rel="noopener">Instagram</a>
              <a href={site.social.facebook} target="_blank" rel="noopener">Facebook</a>
            </span>
          </li>
        </ul>
        <p class="reassure">Forrester Fields is a planning &amp; coordination service — not a venue. I&rsquo;ll happily travel to the venue you choose.</p>
      </aside>

      <div class="contact-form-card" data-reveal>
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { padding-block: clamp(3.5rem, 8vw, 6rem); }
  .contact-grid { display: grid; grid-template-columns: 0.9fr 1.4fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .contact-aside h2 { font-size: 1.6rem; }
  .contact-list { list-style: none; margin: 1.5rem 0; padding: 0; display: grid; gap: 1.3rem; }
  .contact-list .label {
    display: block; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--accent-deep); margin-bottom: 0.3rem;
  }
  .contact-list a { font-size: 1.05rem; }
  .social-links { display: flex; gap: 1.2rem; }
  .reassure {
    font-size: 0.92rem; color: var(--muted);
    border-left: 3px solid var(--accent); padding-left: 1rem;
  }
  .contact-form-card {
    background: var(--bg-deep);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }
  @media (max-width: 880px) { .contact-grid { grid-template-columns: 1fr; } }
</style>
