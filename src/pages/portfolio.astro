---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Cta from '../components/Cta.astro';
import { site } from '../data/site';
import ceremony from '../assets/hero-lakeside-ceremony.jpg';
import dusk from '../assets/lakeside-dusk.png';
import decor from '../assets/portrait.jpg';

const title = 'Wedding Coordination Portfolio | Forrester Fields';
const description =
  "Browse Forrester Fields' wedding & event coordination work across venues in Walton County & metro Atlanta. Real days, beautifully run. Book yours.";

const gallery = [
  { src: ceremony, alt: 'A lakeside wedding ceremony coordinated by Forrester Fields', caption: 'An intimate lakeside ceremony, beginning to end' },
  { src: dusk, alt: 'An evening wedding reception setting glowing with string lights', caption: 'An evening celebration aglow with string lights' },
  { src: decor, alt: 'Soft, romantic draped ceremony details', caption: 'The little details that make the day' },
];

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Portfolio', item: site.url + '/portfolio' },
  ],
};
---

<BaseLayout title={title} description={description} schemas={[breadcrumb]}>
  <section class="page-hero section--alt">
    <div class="container text-center" data-reveal>
      <p class="eyebrow eyebrow--center">Our work</p>
      <h1>A coordination portfolio</h1>
      <p class="lede">Forrester Fields isn&rsquo;t a venue — these are real celebrations we&rsquo;ve helped bring to life at venues across Walton County and metro Atlanta.</p>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container">
      <div class="grid">
        {gallery.map((g) => (
          <figure class="tile" data-reveal>
            <Image src={g.src} alt={g.alt} widths={[500, 800, 1100]} sizes="(max-width: 720px) 100vw, (max-width: 1100px) 50vw, 33vw" />
            <figcaption>{g.caption}</figcaption>
          </figure>
        ))}
      </div>
      <p class="more text-center" data-reveal>More real weddings &amp; events are on the way. Follow along on
        <a href={site.social.instagram} target="_blank" rel="noopener">Instagram</a>.</p>
    </div>
  </section>

  <Cta heading="Picture your day, beautifully run" text="Let&rsquo;s talk about your wedding or event and how I can help it unfold without a hitch." />
</BaseLayout>

<style>
  .page-hero { padding-block: clamp(3.5rem, 8vw, 6rem); }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.4rem;
  }
  .tile { margin: 0; position: relative; overflow: hidden; border-radius: var(--radius); box-shadow: var(--shadow-sm); }
  .tile :global(img) { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; transition: transform 0.6s ease; }
  .tile:hover :global(img) { transform: scale(1.05); }
  .tile figcaption {
    position: absolute; inset: auto 0 0 0;
    padding: 2.5rem 1.2rem 1.1rem;
    color: #fff; font-family: var(--serif); font-size: 1.05rem;
    background: linear-gradient(0deg, rgba(20,18,14,0.78), transparent);
  }
  .more { margin-top: 2.5rem; color: var(--muted); }
</style>
