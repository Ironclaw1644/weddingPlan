# Contact form delivery — Web3Forms (free).
# This value is PUBLIC (safe to expose in client HTML); it is NOT a secret.
#
# Setup (2 minutes): go to https://web3forms.com, enter forresterfields25@gmail.com,
# and they email you an Access Key. Paste it below (and add the same as an
# Environment Variable named PUBLIC_WEB3FORMS_ACCESS_KEY in the Vercel dashboard).
#
# Until this is set, the contact form shows a friendly "email me instead" message.
PUBLIC_WEB3FORMS_ACCESS_KEY=
